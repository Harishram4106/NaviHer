# ==============================================================================
# NaviHer AI — Environment Variables Example
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NaviHer runs out-of-the-box in deterministic prototype mode without needing
# live credentials (USE_SUPABASE=false). If you wish to connect to a live Supabase
# backend, update the values below and run with:
#   flutter run --dart-define-from-file=.env
# ==============================================================================

# Backend Feature Toggle (set to true to connect to Supabase, false for offline mock)
USE_SUPABASE=false

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# Test Suite Configuration (Optional — only needed for live E2E tests)
# ------------------------------------------------------------------------------
# TEST_EMAIL_A=tester1@example.com
# TEST_EMAIL_B=tester2@example.com
# TEST_PASSWORD=YourSecureTestPassword123!
